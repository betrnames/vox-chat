# SpaceXAI / xAI — https://console.x.ai
# Required for live AI Receptionist (POST /api/receptionist)
XAI_API_KEY=
# Optional model override (default: grok-3-mini)
# XAI_MODEL=grok-3-mini

# Lead email — https://formspree.io/f/<your-form-id>
# No hardcoded fallback. If unset, email channel is skipped.
FORMSPREE_ENDPOINT=

# Optional: Google Sheet via Apps Script web app (https only)
LEAD_SHEET_WEBHOOK_URL=

# Automated Google Sheet (preferred) — run: node scripts/setup-google-leads.mjs you@gmail.com
# after saving google-service-account.json in project root
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:O
GOOGLE_SHEET_FORMAT=vox-ops
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Security (required on production) ---
# Shared secret for Vapi server URLs (/api/voice-webhook, /api/voice-luis-live).
# Also set the same value as a custom header on the Vapi assistant: x-vapi-secret
VAPI_WEBHOOK_SECRET=

# Optional: durable rate limits (https://upstash.com Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra browser origins (comma-separated). vox.chat is always allowed.
# ALLOWED_ORIGINS=https://preview.vox.chat

# Force webhook/Twilio auth even in development
# REQUIRE_WEBHOOK_AUTH=true
# REQUIRE_TWILIO_SIGNATURE=true

# Twilio (SMS). Signature verification uses TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REVIEW_OWNER_PHONE=

# Vapi
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_VAPI_NOTIFY_TOOL_ID=
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
VAPI_TRANSFER_TOOL_ID=
LUIS_PHONE_NUMBER=

# SpaceXAI / xAI — https://console.x.ai
# Required for live AI Receptionist (POST /api/receptionist)
XAI_API_KEY=
# Optional model override (default: grok-3-mini)
# XAI_MODEL=grok-3-mini

# Lead email (defaults to existing Formspree form if unset)
FORMSPREE_ENDPOINT=https://formspree.io/f/xzezgyen

# Optional: Google Sheet via free Apps Script web app (doPost)
LEAD_SHEET_WEBHOOK_URL=

# Automated Google Sheet (preferred) — run: node scripts/setup-google-leads.mjs you@gmail.com
# after saving google-service-account.json in project root
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:O
GOOGLE_SHEET_FORMAT=vox-ops
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Google Calendar — this is the schedule. The sheet above is only a lead log.
# 1. In Google Calendar, open the calendar you want jobs on (or create "Vox Jobs")
# 2. Settings → Share with the service account email → "Make changes to events"
# 3. Settings → Integrate calendar → copy Calendar ID
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Los_Angeles
# VOICE_JOB_MINUTES=90
# VOICE_BUSINESS_NAME=Valley Air Pros
# VOICE_OWNER_PHONE=+1XXXXXXXXXX
# Falls back to REVIEW_OWNER_PHONE for emergency and booking texts

